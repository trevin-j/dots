font-family = "Monaspace Neon NF"
font-family-bold = "Monaspace Neon NF"
font-family-italic = "Monaspace Radon NF"
font-family-bold-italic = "Monaspace Radon NF"

font-style = "Regular"
font-style-bold = "ExtraBold"
font-style-italic= "Italic"
font-style-bold-italic = "ExtraBold Italic"

font-feature = +calt, +liga, +ss01, +ss02, +ss03, +ss04, +ss05, +ss06, +ss07, +ss08, +ss09, +ss10, +cv10, +cv11

font-size = 12

window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend

window-vsync = false

window-decoration = none

resize-overlay = never

confirm-close-surface = false

mouse-scroll-multiplier = 0.35

cursor-style-blink = true

config-file = ?colors

window-inherit-working-directory = false
working-directory = home

shell-integration-features = sudo, title, ssh-env
#shell-integration-features = sudo, title, ssh-env, ssh-terminfo

app-notifications = false
